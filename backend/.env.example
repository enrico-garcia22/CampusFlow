# Porta do backend
PORT=3001
# Origem do frontend (pode listar múltiplas separadas por vírgula)
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
# URL base do frontend para links de QR Code e e-mail.
# IMPORTANTE: se você quiser que alunos escaneiem pelo celular na rede local,
# coloque aqui o IP da sua máquina, ex: http://192.168.0.7/CampusFlow/frontend
# Deixar em branco faz o backend detectar o IP automaticamente.
FRONTEND_URL=http://127.0.0.1:5500/frontend

# Banco MariaDB do XAMPP. root sem senha somente para desenvolvimento local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusflow

# Defina um segredo aleatório (pelo menos 32 caracteres); NÃO publique o .env.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_NO_MINIMO_32_CARACTERES

# Tolerância de check-in: 600 segundos = 10 minutos.
# Para testar rapidamente, use 30 e reinicie a API.
GRACE_SECONDS=600

# Segredo exclusivo para proteger RAs (32 bytes = 64 caracteres hexadecimais).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# NÃO reutilize JWT_SECRET; não troque RA_PEPPER após registrar RAs sem planejar a migração.
RA_PEPPER=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS

# =============================================================================
# CONFIGURAÇÃO DE E-MAIL REAL (SMTP)
# Deixe em branco para usar somente a pasta outbox/ local (modo desenvolvimento).
# Preencha para receber o e-mail de confirmação real com QR Code na caixa de entrada.
# =============================================================================

# Servidor SMTP: ex: smtp.gmail.com | smtp.outlook.com | smtp.zoho.com
SMTP_HOST=smtp.gmail.com

# Porta: 587 = STARTTLS (recomendado) | 465 = SSL direto
SMTP_PORT=587

# SMTP_SECURE=true somente para porta 465 (SSL direto). Deixe false para 587 (STARTTLS).
SMTP_SECURE=false

# Usuário SMTP (geralmente o próprio e-mail)
SMTP_USER=seuemail@gmail.com

# Senha SMTP.
# Para Gmail: use uma SENHA DE APP (não a senha normal).
#   Acesse: https://myaccount.google.com > Segurança > Senhas de app
# Para Outlook: use a senha normal da conta ou senha de app se tiver 2FA.
SMTP_PASS=SENHA_DE_APP_AQUI

# Remetente exibido no e-mail (nome + endereço)
SMTP_FROM="CampusFlow" <seuemail@gmail.com>

# Hospedagem Railway: inicializar tabelas no banco vazio na primeira implantação.
# Desative após a primeira execução bem-sucedida.
DB_INIT_ON_START=false

# Hospedagem Railway Free/Trial/Hobby: SMTP de saída bloqueado.
# Alternativa por HTTPS (opcional; requer conta e remetente verificado no Resend).
# Não publique a chave de API.
RESEND_API_KEY=
RESEND_FROM=

# Opcional: ativa rotina de 15 segundos em produção sempre ativa.
# No plano gratuito, mantenha false para economizar recursos.
ENABLE_STATUS_TIMER=false
