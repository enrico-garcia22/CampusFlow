# Porta do backend
PORT=3001
# Origem do frontend React/Vite (mude quando necessário)
FRONTEND_ORIGIN=http://localhost:5173
# URL base do frontend para links de QR Code e e-mail (ex: XAMPP http://localhost/CampusFlow/frontend ou Live Server)
FRONTEND_URL=http://localhost/CampusFlow/frontend

# Banco MariaDB do XAMPP. root sem senha somente para desenvolvimento local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campusflow

# Defina um segredo aleatório (pelo menos 32 caracteres); NÃO publique o .env.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_NO_MINIMO_32_CARACTERES

# Tolerância de check-in: 600 segundos = 10 minutos.
# Para demonstrar rapidamente, use 30 e reinicie a API.
GRACE_SECONDS=600

# Segredo exclusivo para proteger RAs (32 bytes = 64 caracteres hexadecimais).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# NÃO reutilize JWT_SECRET; não troque RA_PEPPER após registrar RAs sem planejar a migração.
RA_PEPPER=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS
